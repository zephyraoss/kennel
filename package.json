{
	"name": "kennel",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"cf:deploy": "pnpm run build && wrangler deploy",
		"cf:gen": "wrangler types",
		"db:gen": "pnpm run auth:gen && drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply D1 --local",
		"db:migrate:preview": "wrangler d1 migrations apply D1 --preview",
		"db:migrate:remote": "wrangler d1 migrations apply D1 --remote",
		"auth:gen": "pnpm dlx auth@1.7.1 generate --config ./auth.cli.ts --output ./src/lib/server/db/schema/auth.ts -y"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.1",
		"@better-auth/mcp": "1.7.1",
		"@better-auth/oauth-provider": "1.7.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"better-auth": "^1.7.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.10",
		"neverthrow": "^8.2.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	}
}
