{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kennel",
	"compatibility_date": "2026-08-23",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"main": "src/worker.ts",
	"alias": {
		"kennel:kit-worker": "./.svelte-kit/cloudflare/_worker.js"
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "kennel.work",
			"zone_name": "kennel.work",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"upload_source_maps": true,
	"keep_vars": true,
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "kennel",
			"database_id": "86569827-ee9c-4e33-84ac-8cc16edf68f5"
		}
	]
}
